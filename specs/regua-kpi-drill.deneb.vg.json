{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "v3 — Régua hierárquica + drill divergente com toggle de cenário Atual/Projetado (Deneb/Power BI). Campos: Nome, Pai, Nivel, Ordem, Desvio, Nota, Planejado, Realizado, Projetado, DesvioProj, NotaProj. Valores em R$ mil. O botão 'Atual | Projetado' troca a régua e o drill entre Realizado e Projetado. pbiContainerWidth/Height injetados pelo Deneb.",
  "autosize": {"type": "none", "resize": true, "contains": "padding"},
  "padding": {"left": 0, "right": 0, "top": 8, "bottom": 8},

  "signals": [
    {"name": "totalWidth",   "update": "pbiContainerWidth"},
    {"name": "containerH",   "update": "pbiContainerHeight"},
    {"name": "labelWidth",   "value": 185},
    {"name": "nameW",        "update": "min(340, totalWidth * 0.45)"},
    {"name": "barAreaWidth", "update": "totalWidth - labelWidth - 8"},
    {"name": "segW",         "update": "barAreaWidth / 5"},
    {"name": "headerH",      "value": 26},
    {"name": "rowH",         "value": 70},
    {"name": "barH",         "value": 26},
    {"name": "barOffY",      "value": 22},
    {"name": "toolbarH",     "value": 30},

    {"name": "topPad",     "update": "toolbarH + 46"},
    {"name": "bottomPad",  "value": 10},
    {"name": "viewportH",  "update": "max(60, containerH - topPad - bottomPad)"},
    {"name": "nChild",     "update": "data('children').length"},
    {"name": "projRowH",   "update": "nChild > 0 ? clamp(viewportH / nChild, 30, 44) : 42"},
    {"name": "barHt",      "update": "min(26, projRowH - 14)"},
    {"name": "contentH",   "update": "nChild * projRowH"},
    {"name": "maxScroll",  "update": "max(0, contentH - viewportH)"},
    {"name": "thumbH",     "update": "max(24, viewportH * (viewportH / max(contentH, 1)))"},
    {"name": "chartPad",   "value": 12},
    {"name": "chartLeft",  "update": "nameW + chartPad"},
    {"name": "chartRight", "update": "totalWidth - 16"},
    {"name": "centerX",    "update": "(chartLeft + chartRight) / 2"},
    {"name": "divMax",     "update": "data('childExtent').length ? data('childExtent')[0].maxAbs : 1"},

    {"name": "segW2",     "value": 76},
    {"name": "segProjX",  "update": "totalWidth - 8 - segW2"},
    {"name": "segAtualX", "update": "segProjX - segW2"},

    {
      "name": "currentNode",
      "value": null,
      "on": [
        {"events": "@areaRow:click", "update": "datum.Nome"},
        {"events": "@backBtn:click", "update": "null"}
      ]
    },
    {
      "name": "cenario",
      "value": "atual",
      "on": [
        {"events": "@segAtual:click", "update": "'atual'"},
        {"events": "@segProj:click", "update": "'proj'"}
      ]
    },

    {
      "name": "scrollY",
      "value": 0,
      "on": [
        {"events": {"signal": "currentNode"}, "update": "0"},
        {"events": {"signal": "nChild"}, "update": "0"},
        {"events": {"signal": "cenario"}, "update": "0"},
        {"events": {"type": "wheel", "consume": true, "filter": ["currentNode !== null"]}, "update": "clamp(scrollY + event.deltaY, 0, maxScroll)"},
        {"events": "[@scrollThumb:pointerdown, window:pointerup] > window:pointermove", "update": "clamp(scrollY + event.movementY * (contentH / viewportH), 0, maxScroll)"}
      ]
    },

    {"name": "animMs", "value": 350},
    {"name": "animStart", "value": 0, "on": [{"events": {"signal": "currentNode"}, "update": "now()"}, {"events": {"signal": "cenario"}, "update": "now()"}]},
    {"name": "tRaw", "value": 1, "on": [{"events": {"type": "timer", "throttle": 20}, "update": "animStart > 0 ? min((now() - animStart) / animMs, 1) : 1"}]},
    {"name": "tEase", "update": "tRaw * (2 - tRaw)"}
  ],

  "data": [
    {"name": "dataset"},

    {
      "name": "regua",
      "source": "dataset",
      "transform": [
        {"type": "filter", "expr": "datum.Nivel <= 2 && currentNode === null"},
        {"type": "collect", "sort": {"field": "Ordem"}},
        {"type": "formula", "as": "notaAtiva", "expr": "cenario === 'proj' ? datum.NotaProj : datum.Nota"},
        {"type": "formula", "as": "desvioAtiva", "expr": "cenario === 'proj' ? datum.DesvioProj : datum.Desvio"},
        {"type": "formula", "as": "rowY", "expr": "datum.Ordem * rowH + headerH + toolbarH"}
      ]
    },
    {
      "name": "empresaBand",
      "source": "regua",
      "transform": [{"type": "filter", "expr": "datum.Nivel === 1"}]
    },
    {
      "name": "zonas",
      "source": "regua",
      "transform": [
        {"type": "formula", "as": "zoneArr", "expr": "[1, 2, 3, 4, 5]"},
        {"type": "flatten", "fields": ["zoneArr"], "as": ["notaZona"]}
      ]
    },
    {
      "name": "zoneMeta",
      "values": [
        {"n": 1, "label": "Crítico"},
        {"n": 2, "label": "Ruim"},
        {"n": 3, "label": "Atenção"},
        {"n": 4, "label": "Bom"},
        {"n": 5, "label": "Ótimo"}
      ],
      "transform": [{"type": "filter", "expr": "currentNode === null"}]
    },

    {
      "name": "children",
      "source": "dataset",
      "transform": [
        {"type": "filter", "expr": "currentNode !== null && datum.Pai === currentNode"},
        {"type": "formula", "as": "execAtiva", "expr": "cenario === 'proj' ? datum.Projetado : datum.Realizado"},
        {"type": "formula", "as": "plan", "expr": "isValid(datum.Planejado) ? datum.Planejado : 0"},
        {"type": "formula", "as": "real", "expr": "isValid(datum.execAtiva) ? datum.execAtiva : 0"},
        {"type": "formula", "as": "semDado", "expr": "(!isValid(datum.Planejado)) || (!isValid(datum.execAtiva))"},
        {"type": "formula", "as": "saldo", "expr": "datum.plan - datum.real"},
        {"type": "formula", "as": "absSaldo", "expr": "abs(datum.saldo)"},
        {"type": "collect", "sort": {"field": "absSaldo", "order": "descending"}},
        {"type": "window", "ops": ["row_number"], "as": ["idx"]}
      ]
    },
    {
      "name": "childExtent",
      "source": "children",
      "transform": [{"type": "aggregate", "fields": ["absSaldo"], "ops": ["max"], "as": ["maxAbs"]}]
    },
    {
      "name": "navState",
      "values": [{}],
      "transform": [{"type": "filter", "expr": "currentNode !== null"}]
    }
  ],

  "scales": [
    {
      "name": "colorScale",
      "type": "ordinal",
      "domain": [1, 2, 3, 4, 5],
      "range": ["#e15759", "#ED8B00", "#fcad04", "#00b2a9", "#009e47"]
    },
    {
      "name": "xDiv",
      "type": "linear",
      "zero": false,
      "clamp": true,
      "domain": [{"signal": "-divMax"}, {"signal": "divMax"}],
      "range": [{"signal": "chartLeft"}, {"signal": "chartRight"}]
    }
  ],

  "marks": [
    {
      "type": "rule",
      "encode": {"update": {"x": {"value": 0}, "x2": {"signal": "totalWidth"}, "y": {"signal": "toolbarH"}, "stroke": {"value": "#e6e6e6"}, "strokeWidth": {"value": 1}}}
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "enter": {"align": {"value": "right"}, "baseline": {"value": "middle"}, "fontSize": {"value": 10}, "fill": {"value": "#888888"}},
        "update": {"x": {"signal": "segAtualX - 8"}, "y": {"value": 15}, "text": {"value": "Cenário"}}
      }
    },
    {
      "type": "rect",
      "name": "segAtual",
      "encode": {
        "enter": {"cursor": {"value": "pointer"}, "stroke": {"value": "#c8ced5"}, "strokeWidth": {"value": 1}, "cornerRadiusTopLeft": {"value": 4}, "cornerRadiusBottomLeft": {"value": 4}},
        "update": {"x": {"signal": "segAtualX"}, "y": {"value": 4}, "width": {"signal": "segW2"}, "height": {"value": 22}, "fill": {"signal": "cenario === 'atual' ? '#4c78a8' : '#eef1f4'"}}
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "enter": {"align": {"value": "center"}, "baseline": {"value": "middle"}, "fontSize": {"value": 11}, "fontWeight": {"value": "bold"}},
        "update": {"x": {"signal": "segAtualX + segW2 / 2"}, "y": {"value": 15}, "text": {"value": "Atual"}, "fill": {"signal": "cenario === 'atual' ? '#ffffff' : '#555555'"}}
      }
    },
    {
      "type": "rect",
      "name": "segProj",
      "encode": {
        "enter": {"cursor": {"value": "pointer"}, "stroke": {"value": "#c8ced5"}, "strokeWidth": {"value": 1}, "cornerRadiusTopRight": {"value": 4}, "cornerRadiusBottomRight": {"value": 4}},
        "update": {"x": {"signal": "segProjX"}, "y": {"value": 4}, "width": {"signal": "segW2"}, "height": {"value": 22}, "fill": {"signal": "cenario === 'proj' ? '#4c78a8' : '#eef1f4'"}}
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "enter": {"align": {"value": "center"}, "baseline": {"value": "middle"}, "fontSize": {"value": 11}, "fontWeight": {"value": "bold"}},
        "update": {"x": {"signal": "segProjX + segW2 / 2"}, "y": {"value": 15}, "text": {"value": "Projetado"}, "fill": {"signal": "cenario === 'proj' ? '#ffffff' : '#555555'"}}
      }
    },

    {
      "type": "rect",
      "from": {"data": "empresaBand"},
      "encode": {"update": {"x": {"value": 0}, "width": {"signal": "totalWidth"}, "y": {"signal": "datum.rowY"}, "height": {"signal": "rowH"}, "fill": {"value": "#eef3fb"}, "opacity": {"signal": "tEase"}}}
    },
    {
      "type": "rect",
      "from": {"data": "empresaBand"},
      "encode": {"update": {"x": {"value": 0}, "width": {"value": 4}, "y": {"signal": "datum.rowY"}, "height": {"signal": "rowH"}, "fill": {"value": "#4c78a8"}, "opacity": {"signal": "tEase"}}}
    },
    {
      "type": "text",
      "from": {"data": "zoneMeta"},
      "encode": {
        "enter": {"align": {"value": "center"}, "baseline": {"value": "middle"}, "fontSize": {"value": 10}, "fontWeight": {"value": "bold"}},
        "update": {"x": {"signal": "labelWidth + (datum.n - 0.5) * segW"}, "y": {"signal": "toolbarH + headerH / 2"}, "text": {"field": "label"}, "fill": {"signal": "scale('colorScale', datum.n)"}, "limit": {"signal": "segW - 4"}, "opacity": {"signal": "tEase"}}
      }
    },
    {
      "type": "rule",
      "from": {"data": "regua"},
      "encode": {
        "enter": {"stroke": {"value": "#e0e0e0"}, "strokeWidth": {"value": 1}},
        "update": {"x": {"value": 0}, "x2": {"signal": "totalWidth"}, "y": {"field": "rowY"}, "opacity": {"signal": "0.8 * tEase"}}
      }
    },
    {
      "type": "rect",
      "from": {"data": "zonas"},
      "encode": {
        "enter": {"strokeWidth": {"value": 1.5}, "cornerRadius": {"value": 3}},
        "update": {
          "x": {"signal": "labelWidth + (datum.notaZona - 1) * segW"},
          "width": {"signal": "segW - 2"},
          "y": {"signal": "datum.rowY + barOffY"},
          "height": {"signal": "barH"},
          "fill": {"signal": "scale('colorScale', datum.notaZona)"},
          "fillOpacity": {"signal": "!isValid(datum.notaAtiva) ? 0.55 : (datum.notaZona === datum.notaAtiva ? 0.95 : 0.28)"},
          "stroke": {"signal": "datum.notaZona === datum.notaAtiva ? '#ffffff' : null"},
          "opacity": {"signal": "tEase"}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "zonas"},
      "encode": {
        "enter": {"align": {"value": "center"}, "baseline": {"value": "middle"}, "fontSize": {"value": 11}, "fontWeight": {"value": "bold"}},
        "update": {
          "x": {"signal": "labelWidth + (datum.notaZona - 0.5) * segW"},
          "y": {"signal": "datum.rowY + barOffY + barH / 2"},
          "text": {"signal": "'' + datum.notaZona"},
          "fill": {"signal": "datum.notaZona === datum.notaAtiva ? '#ffffff' : '#3a3a3a'"},
          "opacity": {"signal": "tEase"}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "regua"},
      "encode": {
        "enter": {"align": {"value": "left"}, "baseline": {"value": "middle"}, "fill": {"value": "#333333"}},
        "update": {"x": {"value": 12}, "y": {"signal": "datum.rowY + barOffY + barH / 2"}, "text": {"field": "Nome"}, "fontSize": {"signal": "datum.Nivel === 1 ? 14 : 11"}, "fontWeight": {"signal": "datum.Nivel === 1 ? 'bold' : 'normal'"}, "limit": {"signal": "labelWidth - 20"}, "opacity": {"signal": "tEase"}}
      }
    },
    {
      "type": "text",
      "from": {"data": "regua"},
      "encode": {
        "enter": {"align": {"value": "center"}, "baseline": {"value": "top"}, "fontWeight": {"value": "bold"}},
        "update": {"x": {"signal": "isValid(datum.notaAtiva) ? labelWidth + (datum.notaAtiva - 0.5) * segW : labelWidth + barAreaWidth / 2"}, "y": {"signal": "datum.rowY + 2"}, "text": {"signal": "isValid(datum.desvioAtiva) ? replace(format(datum.desvioAtiva, '.2f'), '.', ',') + '%' : '--'"}, "fontSize": {"signal": "datum.Nivel === 1 ? 16 : 13"}, "fill": {"signal": "isValid(datum.notaAtiva) ? scale('colorScale', datum.notaAtiva) : '#aaaaaa'"}, "opacity": {"signal": "tEase"}}
      }
    },
    {
      "type": "symbol",
      "from": {"data": "regua"},
      "encode": {
        "enter": {"shape": {"value": "triangle-up"}, "stroke": {"value": "white"}, "strokeWidth": {"value": 1}},
        "update": {"x": {"signal": "isValid(datum.notaAtiva) ? labelWidth + (datum.notaAtiva - 0.5) * segW : -999"}, "y": {"signal": "datum.rowY + barOffY + barH + 9"}, "size": {"signal": "min(segW * 14, 350)"}, "fill": {"signal": "isValid(datum.notaAtiva) ? scale('colorScale', datum.notaAtiva) : 'transparent'"}, "opacity": {"signal": "(isValid(datum.notaAtiva) ? 1 : 0) * tEase"}}
      }
    },
    {
      "type": "text",
      "from": {"data": "regua"},
      "encode": {
        "enter": {"align": {"value": "center"}, "baseline": {"value": "middle"}, "fontSize": {"value": 14}, "fill": {"value": "#9aa6b2"}},
        "update": {"x": {"signal": "totalWidth - 12"}, "y": {"signal": "datum.rowY + barOffY + barH / 2"}, "text": {"value": "❯"}, "opacity": {"signal": "tEase"}}
      }
    },
    {
      "type": "rect",
      "name": "areaRow",
      "from": {"data": "regua"},
      "encode": {
        "enter": {"cursor": {"value": "pointer"}, "fill": {"value": "#4c78a8"}},
        "update": {
          "x": {"value": 0},
          "width": {"signal": "totalWidth"},
          "y": {"signal": "datum.rowY"},
          "height": {"signal": "rowH"},
          "fillOpacity": {"value": 0},
          "tooltip": {"signal": "{'Nó': datum.Nome, 'Desvio atual': isValid(datum.Desvio) ? replace(format(datum.Desvio, '.2f'), '.', ',') + '%' : '--', 'Nota atual': isValid(datum.Nota) ? datum.Nota : '--', 'Desvio projetado': isValid(datum.DesvioProj) ? replace(format(datum.DesvioProj, '.2f'), '.', ',') + '%' : '--', 'Nota projetada': isValid(datum.NotaProj) ? datum.NotaProj : '--'}"}
        },
        "hover": {"fillOpacity": {"value": 0.10}}
      }
    },

    {
      "type": "rule",
      "from": {"data": "navState"},
      "encode": {"update": {"x": {"signal": "centerX"}, "y": {"signal": "topPad"}, "y2": {"signal": "topPad + min(contentH, viewportH)"}, "stroke": {"value": "#9aa6b2"}, "strokeWidth": {"value": 1.5}, "opacity": {"signal": "tEase"}}}
    },
    {
      "type": "text",
      "from": {"data": "navState"},
      "encode": {
        "enter": {"align": {"value": "right"}, "baseline": {"value": "bottom"}, "fontSize": {"value": 10}, "fill": {"value": "#c0504d"}},
        "update": {"x": {"signal": "centerX - 8"}, "y": {"signal": "topPad - 8"}, "text": {"value": "◄ Estouro (gastou mais)"}, "opacity": {"signal": "tEase"}}
      }
    },
    {
      "type": "text",
      "from": {"data": "navState"},
      "encode": {
        "enter": {"align": {"value": "left"}, "baseline": {"value": "bottom"}, "fontSize": {"value": 10}, "fill": {"value": "#4e9a51"}},
        "update": {"x": {"signal": "centerX + 8"}, "y": {"signal": "topPad - 8"}, "text": {"value": "Economia (gastou menos) ►"}, "opacity": {"signal": "tEase"}}
      }
    },

    {
      "type": "group",
      "name": "drillScroll",
      "clip": true,
      "encode": {"update": {"x": {"value": 0}, "y": {"signal": "topPad"}, "width": {"signal": "totalWidth"}, "height": {"signal": "viewportH"}}},
      "marks": [
        {
          "type": "rect",
          "from": {"data": "children"},
          "encode": {
            "enter": {"cornerRadius": {"value": 3}},
            "update": {
              "x": {"signal": "centerX + (scale('xDiv', min(datum.saldo, 0)) - centerX) * tEase"},
              "x2": {"signal": "centerX + (scale('xDiv', max(datum.saldo, 0)) - centerX) * tEase"},
              "y": {"signal": "(datum.idx - 1) * projRowH - scrollY + (projRowH - barHt) / 2"},
              "height": {"signal": "barHt"},
              "fill": {"signal": "datum.semDado ? '#c7ccd1' : (datum.saldo < 0 ? '#e15759' : '#009e47')"},
              "opacity": {"signal": "tEase"},
              "tooltip": {"signal": "{'Item': datum.Nome, 'Planejado': isValid(datum.Planejado) ? 'R$ ' + replace(format(datum.Planejado, ',.0f'), /,/g, '.') + ' mil' : '—', 'Realizado': isValid(datum.Realizado) ? 'R$ ' + replace(format(datum.Realizado, ',.0f'), /,/g, '.') + ' mil' : '—', 'Projetado': isValid(datum.Projetado) ? 'R$ ' + replace(format(datum.Projetado, ',.0f'), /,/g, '.') + ' mil' : '—', 'Saldo': (datum.saldo < 0 ? '−' : '+') + 'R$ ' + replace(format(datum.absSaldo, ',.0f'), /,/g, '.') + ' mil'}"}
            }
          }
        },
        {
          "type": "text",
          "from": {"data": "children"},
          "encode": {
            "enter": {"align": {"value": "left"}, "baseline": {"value": "middle"}, "fill": {"value": "#333333"}, "fontSize": {"value": 11}},
            "update": {"x": {"value": 6}, "y": {"signal": "(datum.idx - 1) * projRowH - scrollY + projRowH / 2"}, "text": {"field": "Nome"}, "limit": {"signal": "nameW - 12"}, "opacity": {"signal": "tEase"}}
          }
        },
        {
          "type": "text",
          "from": {"data": "children"},
          "encode": {
            "enter": {"baseline": {"value": "middle"}, "fontSize": {"value": 11}, "fontWeight": {"value": "bold"}},
            "update": {
              "x": {"signal": "(centerX + (scale('xDiv', datum.saldo) - centerX) * tEase) + ((datum.saldo < 0 ? ((scale('xDiv', datum.saldo) - nameW) < 90) : ((totalWidth - scale('xDiv', datum.saldo)) < 90)) ? (datum.saldo < 0 ? 5 : -5) : (datum.saldo < 0 ? -5 : 5))"},
              "y": {"signal": "(datum.idx - 1) * projRowH - scrollY + projRowH / 2"},
              "align": {"signal": "(datum.saldo < 0 ? ((scale('xDiv', datum.saldo) - nameW) < 90) : ((totalWidth - scale('xDiv', datum.saldo)) < 90)) ? (datum.saldo < 0 ? 'left' : 'right') : (datum.saldo < 0 ? 'right' : 'left')"},
              "text": {"signal": "(datum.semDado ? '' : (datum.saldo < 0 ? '−' : '+')) + 'R$ ' + replace(format(datum.absSaldo, ',.0f'), /,/g, '.') + ' mil'"},
              "fill": {"signal": "(datum.saldo < 0 ? ((scale('xDiv', datum.saldo) - nameW) < 90) : ((totalWidth - scale('xDiv', datum.saldo)) < 90)) ? '#ffffff' : (datum.semDado ? '#7a7f85' : (datum.saldo < 0 ? '#e15759' : '#009e47'))"},
              "opacity": {"signal": "tEase"}
            }
          }
        }
      ]
    },

    {
      "type": "rect",
      "from": {"data": "navState"},
      "encode": {"update": {"x": {"signal": "totalWidth - 6"}, "width": {"value": 4}, "y": {"signal": "topPad"}, "height": {"signal": "viewportH"}, "fill": {"value": "#ececec"}, "cornerRadius": {"value": 2}, "opacity": {"signal": "maxScroll > 0 ? tEase : 0"}}}
    },
    {
      "type": "rect",
      "name": "scrollThumb",
      "from": {"data": "navState"},
      "encode": {
        "enter": {"cursor": {"value": "pointer"}},
        "update": {"x": {"signal": "totalWidth - 6"}, "width": {"value": 4}, "height": {"signal": "thumbH"}, "y": {"signal": "topPad + (maxScroll > 0 ? (viewportH - thumbH) * (scrollY / maxScroll) : 0)"}, "fill": {"value": "#b0b0b0"}, "cornerRadius": {"value": 2}, "opacity": {"signal": "maxScroll > 0 ? tEase : 0"}}
      }
    },

    {
      "type": "group",
      "name": "backBtn",
      "from": {"data": "navState"},
      "encode": {
        "enter": {"cursor": {"value": "pointer"}},
        "update": {"x": {"value": 0}, "y": {"signal": "toolbarH + 6"}, "width": {"value": 96}, "height": {"value": 26}, "fill": {"value": "#f0f0f0"}, "stroke": {"value": "#cccccc"}, "cornerRadius": {"value": 4}, "opacity": {"signal": "tEase"}}
      },
      "marks": [
        {
          "type": "text",
          "interactive": false,
          "encode": {
            "enter": {"align": {"value": "center"}, "baseline": {"value": "middle"}, "fill": {"value": "#444444"}, "fontSize": {"value": 11}, "fontWeight": {"value": "bold"}},
            "update": {"x": {"value": 48}, "y": {"value": 13}, "text": {"value": "← Voltar"}}
          }
        }
      ]
    },
    {
      "type": "text",
      "from": {"data": "navState"},
      "encode": {
        "enter": {"align": {"value": "left"}, "baseline": {"value": "middle"}, "fill": {"value": "#333333"}, "fontSize": {"value": 13}, "fontWeight": {"value": "bold"}},
        "update": {"x": {"value": 108}, "y": {"signal": "toolbarH + 15"}, "text": {"signal": "'Ofensores · ' + currentNode + (cenario === 'proj' ? '  (projetado)' : '')"}, "opacity": {"signal": "tEase"}}
      }
    },
    {
      "type": "text",
      "from": {"data": "navState"},
      "encode": {
        "enter": {"align": {"value": "left"}, "baseline": {"value": "middle"}, "fill": {"value": "#9aa6b2"}, "fontSize": {"value": 10}},
        "update": {"x": {"value": 108}, "y": {"signal": "toolbarH + 31"}, "text": {"value": "Valores em R$ mil"}, "opacity": {"signal": "tEase"}}
      }
    }
  ]
}

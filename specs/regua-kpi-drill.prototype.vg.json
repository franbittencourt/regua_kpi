{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "PROTÓTIPO (rev: scroll/nulos/nomes/rótulo) — igual ao Deneb, com width/height e dataset fictício embutido. TI tem muitos projetos (testa scroll) e um sem realização (testa nulo cinza). Testar em vega.github.io/editor.",
  "width": 760,
  "height": 320,
  "autosize": {
    "type": "none",
    "resize": true,
    "contains": "padding"
  },
  "padding": {
    "left": 0,
    "right": 0,
    "top": 8,
    "bottom": 8
  },
  "signals": [
    {
      "name": "totalWidth",
      "update": "width"
    },
    {
      "name": "containerH",
      "update": "height"
    },
    {
      "name": "labelWidth",
      "value": 185
    },
    {
      "name": "nameW",
      "update": "min(240, totalWidth * 0.33)"
    },
    {
      "name": "barAreaWidth",
      "update": "totalWidth - labelWidth - 8"
    },
    {
      "name": "segW",
      "update": "barAreaWidth / 5"
    },
    {
      "name": "headerH",
      "value": 26
    },
    {
      "name": "rowH",
      "value": 70
    },
    {
      "name": "barH",
      "value": 26
    },
    {
      "name": "barOffY",
      "value": 22
    },
    {
      "name": "topPad",
      "value": 58
    },
    {
      "name": "bottomPad",
      "value": 10
    },
    {
      "name": "viewportH",
      "update": "max(60, containerH - topPad - bottomPad)"
    },
    {
      "name": "nChild",
      "update": "data('children').length"
    },
    {
      "name": "projRowH",
      "update": "nChild > 0 ? clamp(viewportH / nChild, 30, 44) : 42"
    },
    {
      "name": "barHt",
      "update": "min(26, projRowH - 14)"
    },
    {
      "name": "contentH",
      "update": "nChild * projRowH"
    },
    {
      "name": "maxScroll",
      "update": "max(0, contentH - viewportH)"
    },
    {
      "name": "thumbH",
      "update": "max(24, viewportH * (viewportH / max(contentH, 1)))"
    },
    {
      "name": "chartPad",
      "value": 80
    },
    {
      "name": "chartLeft",
      "update": "nameW + chartPad"
    },
    {
      "name": "chartRight",
      "update": "totalWidth - 100"
    },
    {
      "name": "centerX",
      "update": "(chartLeft + chartRight) / 2"
    },
    {
      "name": "divMax",
      "update": "data('childExtent').length ? data('childExtent')[0].maxAbs : 1"
    },
    {
      "name": "currentNode",
      "value": null,
      "on": [
        {
          "events": "@areaRow:click",
          "update": "datum.Nome"
        },
        {
          "events": "@backBtn:click",
          "update": "null"
        }
      ]
    },
    {
      "name": "scrollY",
      "value": 0,
      "on": [
        {
          "events": {
            "signal": "currentNode"
          },
          "update": "0"
        },
        {
          "events": {
            "signal": "nChild"
          },
          "update": "0"
        },
        {
          "events": {
            "type": "wheel",
            "consume": true,
            "filter": [
              "currentNode !== null"
            ]
          },
          "update": "clamp(scrollY + event.deltaY, 0, maxScroll)"
        },
        {
          "events": "[@scrollThumb:pointerdown, window:pointerup] > window:pointermove",
          "update": "clamp(scrollY + event.movementY * (contentH / viewportH), 0, maxScroll)"
        }
      ]
    },
    {
      "name": "animMs",
      "value": 350
    },
    {
      "name": "animStart",
      "value": 0,
      "on": [
        {
          "events": {
            "signal": "currentNode"
          },
          "update": "now()"
        }
      ]
    },
    {
      "name": "tRaw",
      "value": 1,
      "on": [
        {
          "events": {
            "type": "timer",
            "throttle": 20
          },
          "update": "animStart > 0 ? min((now() - animStart) / animMs, 1) : 1"
        }
      ]
    },
    {
      "name": "tEase",
      "update": "tRaw * (2 - tRaw)"
    }
  ],
  "data": [
    {
      "name": "dataset",
      "values": [
        {
          "Nome": "Total",
          "Pai": null,
          "Nivel": 1,
          "Ordem": 0,

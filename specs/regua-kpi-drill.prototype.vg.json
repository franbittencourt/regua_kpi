    {
      "type": "group",
      "name": "drillScroll",
      "clip": true,
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "y": {
            "signal": "topPad"
          },
          "width": {
            "signal": "totalWidth"
          },
          "height": {
            "signal": "viewportH"
          }
        }
      },
      "marks": [
        {
          "type": "rect",
          "from": {
            "data": "children"
          },
          "encode": {
            "enter": {
              "cornerRadius": {
                "value": 3
              }
            },
            "update": {
              "x": {
                "signal": "centerX + (scale('xDiv', min(datum.saldo, 0)) - centerX) * tEase"
              },
              "x2": {
                "signal": "centerX + (scale('xDiv', max(datum.saldo, 0)) - centerX) * tEase"
              },
              "y": {
                "signal": "(datum.idx - 1) * projRowH - scrollY + (projRowH - barHt) / 2"
              },
              "height": {
                "signal": "barHt"
              },
              "fill": {
                "signal": "datum.semDado ? '#c7ccd1' : scale('colorScale', datum.Nota)"
              },
              "opacity": {
                "signal": "tEase"
              },
              "tooltip": {
                "signal": "{'Item': datum.Nome, 'Planejado': isValid(datum.Planejado) ? 'R$ ' + replace(format(datum.Planejado, ',.0f'), /,/g, '.') + ' mil' : '—', 'Realizado': isValid(datum.Realizado) ? 'R$ ' + replace(format(datum.Realizado, ',.0f'), /,/g, '.') + ' mil' : '— (sem realização)', 'Saldo': (datum.saldo < 0 ? '−' : '+') + 'R$ ' + replace(format(datum.absSaldo, ',.0f'), /,/g, '.') + ' mil', 'Desvio': isValid(datum.Desvio) ? replace(format(datum.Desvio, '.1f'), '.', ',') + '%' : '—'}"
              }
            }
          }
        },
        {
          "type": "text",
          "from": {
            "data": "children"
          },
          "encode": {
            "enter": {
              "align": {
                "value": "left"
              },
              "baseline": {
                "value": "middle"
              },
              "fill": {
                "value": "#333333"
              },
              "fontSize": {
                "value": 11
              }
            },
            "update": {
              "x": {
                "value": 6
              },
              "y": {
                "signal": "(datum.idx - 1) * projRowH - scrollY + projRowH / 2"
              },
              "text": {
                "field": "Nome"
              },
              "limit": {
                "signal": "nameW - 12"
              },
              "opacity": {
                "signal": "tEase"
              }
            }
          }
        },
        {
          "type": "text",
          "from": {
            "data": "children"
          },
          "encode": {
            "enter": {
              "baseline": {
                "value": "middle"
              },
              "fontSize": {
                "value": 11
              },
              "fontWeight": {
                "value": "bold"
              }
            },
            "update": {
              "x": {
                "signal": "(centerX + (scale('xDiv', datum.saldo) - centerX) * tEase) + ((datum.saldo < 0 ? ((scale('xDiv', datum.saldo) - nameW) < 84) : ((totalWidth - scale('xDiv', datum.saldo)) < 84)) ? (datum.saldo < 0 ? 5 : -5) : (datum.saldo < 0 ? -5 : 5))"
              },
              "y": {
                "signal": "(datum.idx - 1) * projRowH - scrollY + projRowH / 2"
              },
              "align": {
                "signal": "(datum.saldo < 0 ? ((scale('xDiv', datum.saldo) - nameW) < 84) : ((totalWidth - scale('xDiv', datum.saldo)) < 84)) ? (datum.saldo < 0 ? 'left' : 'right') : (datum.saldo < 0 ? 'right' : 'left')"
              },
              "text": {
                "signal": "(datum.semDado ? '' : (datum.saldo < 0 ? '−' : '+')) + 'R$ ' + replace(format(datum.absSaldo, ',.0f'), /,/g, '.') + ' mil'"
              },
              "fill": {
                "signal": "(datum.saldo < 0 ? ((scale('xDiv', datum.saldo) - nameW) < 84) : ((totalWidth - scale('xDiv', datum.saldo)) < 84)) ? '#ffffff' : (datum.semDado ? '#7a7f85' : scale('colorScale', datum.Nota))"
              },
              "opacity": {
                "signal": "tEase"
              }
            }
          }
        }
      ]
    },
    {
      "type": "rect",
      "from": {
        "data": "navState"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "totalWidth - 6"
          },
          "width": {
            "value": 4
          },
          "y": {
            "signal": "topPad"
          },
          "height": {
            "signal": "viewportH"
          },
          "fill": {
            "value": "#ececec"
          },
          "cornerRadius": {
            "value": 2
          },
          "opacity": {
            "signal": "maxScroll > 0 ? tEase : 0"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "scrollThumb",
      "from": {
        "data": "navState"
      },
      "encode": {
        "enter": {
          "cursor": {
            "value": "pointer"
          }
        },
        "update": {
          "x": {
            "signal": "totalWidth - 6"
          },
          "width": {
            "value": 4
          },
          "height": {
            "signal": "thumbH"
          },
          "y": {
            "signal": "topPad + (maxScroll > 0 ? (viewportH - thumbH) * (scrollY / maxScroll) : 0)"
          },
          "fill": {
            "value": "#b0b0b0"
          },
          "cornerRadius": {
            "value": 2
          },
          "opacity": {
            "signal": "maxScroll > 0 ? tEase : 0"
          }
        }
      }

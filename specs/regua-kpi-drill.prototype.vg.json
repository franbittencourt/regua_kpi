          "Ordem": 0,
          "Desvio": 1.0,
          "Nota": 4,
          "Planejado": 100,
          "Realizado": 99
        }
      ]
    },
    {
      "name": "regua",
      "source": "dataset",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.Nivel <= 2 && currentNode === null"
        },
        {
          "type": "collect",
          "sort": {
            "field": "Ordem"
          }
        },
        {
          "type": "formula",
          "as": "rowY",
          "expr": "datum.Ordem * rowH + headerH"
        }
      ]
    },
    {
      "name": "empresaBand",
      "source": "regua",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.Nivel === 1"
        }
      ]
    },
    {
      "name": "zonas",
      "source": "regua",
      "transform": [
        {
          "type": "formula",
          "as": "zoneArr",
          "expr": "[1, 2, 3, 4, 5]"
        },
        {
          "type": "flatten",
          "fields": [
            "zoneArr"
          ],
          "as": [
            "notaZona"
          ]
        }
      ]
    },
    {
      "name": "zoneMeta",
      "values": [
        {
          "n": 1,
          "label": "Crítico"
        },
        {
          "n": 2,
          "label": "Ruim"
        },
        {
          "n": 3,
          "label": "Atenção"
        },
        {
          "n": 4,
          "label": "Bom"
        },
        {
          "n": 5,
          "label": "Ótimo"
        }
      ],
      "transform": [
        {
          "type": "filter",
          "expr": "currentNode === null"
        }
      ]
    },
    {
      "name": "children",
      "source": "dataset",
      "transform": [
        {
          "type": "filter",
          "expr": "currentNode !== null && datum.Pai === currentNode"
        },
        {
          "type": "formula",
          "as": "plan",
          "expr": "isValid(datum.Planejado) ? datum.Planejado : 0"
        },
        {
          "type": "formula",
          "as": "real",
          "expr": "isValid(datum.Realizado) ? datum.Realizado : 0"
        },
        {
          "type": "formula",
          "as": "semDado",
          "expr": "(!isValid(datum.Planejado)) || (!isValid(datum.Realizado))"
        },
        {
          "type": "formula",
          "as": "saldo",
          "expr": "datum.plan - datum.real"
        },
        {
          "type": "formula",
          "as": "absSaldo",
          "expr": "abs(datum.saldo)"
        },
        {
          "type": "collect",
          "sort": {
            "field": "absSaldo",
            "order": "descending"
          }
        },
        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "as": [
            "idx"
          ]
        }
      ]
    },
    {
      "name": "childExtent",
      "source": "children",
      "transform": [
        {
          "type": "aggregate",
          "fields": [
            "absSaldo"
          ],
          "ops": [
            "max"
          ],
          "as": [
            "maxAbs"
          ]
        }
      ]
    },
    {
      "name": "navState",
      "values": [
        {}
      ],
      "transform": [
        {
          "type": "filter",
          "expr": "currentNode !== null"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "colorScale",
      "type": "ordinal",
      "domain": [
        1,
        2,
        3,
        4,
        5
      ],
      "range": [
        "#e15759",
        "#ED8B00",
        "#fcad04",
        "#00b2a9",
        "#009e47"
      ]
    },
    {
      "name": "xDiv",
      "type": "linear",
      "zero": false,
      "clamp": true,
      "domain": [
        {
          "signal": "-divMax"
        },
        {
          "signal": "divMax"
        }
      ],
      "range": [
        {
          "signal": "chartLeft"
        },
        {
          "signal": "chartRight"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "empresaBand"
      },
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "width": {
            "signal": "totalWidth"
          },
          "y": {
            "signal": "datum.rowY"
          },
          "height": {
            "signal": "rowH"
          },
          "fill": {
            "value": "#eef3fb"
          },
          "opacity": {
            "signal": "tEase"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "empresaBand"
      },
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "width": {
            "value": 4
          },
          "y": {
            "signal": "datum.rowY"
          },
          "height": {
            "signal": "rowH"
          },
          "fill": {
            "value": "#4c78a8"
          },
          "opacity": {
            "signal": "tEase"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "zoneMeta"
      },
      "encode": {
        "enter": {
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "value": 10
          },
          "fontWeight": {
            "value": "bold"
          }
        },
        "update": {
          "x": {
            "signal": "labelWidth + (datum.n - 0.5) * segW"
          },
          "y": {
            "signal": "headerH / 2"
          },
          "text": {
            "field": "label"
          },
          "fill": {
            "signal": "scale('colorScale', datum.n)"
          },
          "limit": {
            "signal": "segW - 4"
          },
          "opacity": {
            "signal": "tEase"
          }
        }
      }
    },
    {
      "type": "rule",
      "from": {
        "data": "regua"
      },
      "encode": {
        "enter": {
          "stroke": {
            "value": "#e0e0e0"
          },
          "strokeWidth": {
            "value": 1
          }
        },
        "update": {
          "x": {
            "value": 0
          },
          "x2": {
            "signal": "totalWidth"
          },
          "y": {
            "field": "rowY"
          },
          "opacity": {
            "signal": "0.8 * tEase"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "zonas"
      },
      "encode": {
        "enter": {
          "strokeWidth": {
            "value": 1.5
          },
          "cornerRadius": {
            "value": 3
          }
        },
        "update": {
          "x": {
            "signal": "labelWidth + (datum.notaZona - 1) * segW"
          },
          "width": {
            "signal": "segW - 2"
          },
          "y": {
            "signal": "datum.rowY + barOffY"
          },
          "height": {
            "signal": "barH"
          },
          "fill": {
            "signal": "scale('colorScale', datum.notaZona)"
          },
          "fillOpacity": {
            "signal": "!isValid(datum.Nota) ? 0.55 : (datum.notaZona === datum.Nota ? 0.95 : 0.28)"
          },
          "stroke": {
            "signal": "datum.notaZona === datum.Nota ? '#ffffff' : null"
          },
          "opacity": {
            "signal": "tEase"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "regua"
      },
      "encode": {
        "enter": {
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "middle"
          },
          "fill": {
            "value": "#333333"
          }
        },
        "update": {
          "x": {
            "value": 12
          },
          "y": {
            "signal": "datum.rowY + barOffY + barH / 2"
          },
          "text": {
            "field": "Nome"
          },
          "fontSize": {
            "signal": "datum.Nivel === 1 ? 14 : 11"
          },
          "fontWeight": {
            "signal": "datum.Nivel === 1 ? 'bold' : 'normal'"
          },
          "limit": {
            "signal": "labelWidth - 20"
          },
          "opacity": {
            "signal": "tEase"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "regua"
      },
      "encode": {
        "enter": {
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "top"
          },
          "fontWeight": {
            "value": "bold"
          }
        },
        "update": {
          "x": {
            "signal": "isValid(datum.Nota) ? labelWidth + (datum.Nota - 0.5) * segW : labelWidth + barAreaWidth / 2"
          },
          "y": {
            "signal": "datum.rowY + 2"
          },
          "text": {
            "signal": "isValid(datum.Desvio) ? replace(format(datum.Desvio, '.2f'), '.', ',') + '%' : '--'"
          },
          "fontSize": {
            "signal": "datum.Nivel === 1 ? 16 : 13"
          },
          "fill": {
            "signal": "isValid(datum.Nota) ? scale('colorScale', datum.Nota) : '#aaaaaa'"
          },
          "opacity": {
            "signal": "tEase"
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
        "data": "regua"
      },
      "encode": {
        "enter": {
          "shape": {
            "value": "triangle-up"
          },
          "stroke": {
            "value": "white"
          },
          "strokeWidth": {
            "value": 1
          }
        },
        "update": {
          "x": {
            "signal": "isValid(datum.Nota) ? labelWidth + (datum.Nota - 0.5) * segW : -999"
          },
          "y": {
            "signal": "datum.rowY + barOffY + barH + 9"
          },
          "size": {
            "signal": "min(segW * 14, 350)"
          },
          "fill": {
            "signal": "isValid(datum.Nota) ? scale('colorScale', datum.Nota) : 'transparent'"
          },
          "opacity": {
            "signal": "(isValid(datum.Nota) ? 1 : 0) * tEase"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "regua"
      },
      "encode": {
        "enter": {
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "value": 14
          },
          "fill": {
            "value": "#9aa6b2"
          }
        },
        "update": {
          "x": {
            "signal": "totalWidth - 12"
          },
          "y": {
            "signal": "datum.rowY + barOffY + barH / 2"
          },
          "text": {
            "value": "❯"
          },
          "opacity": {
            "signal": "tEase"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "areaRow",
      "from": {
        "data": "regua"
      },
      "encode": {
        "enter": {
          "cursor": {
            "value": "pointer"
          },
          "fill": {
            "value": "#4c78a8"
          }
        },
        "update": {
          "x": {
            "value": 0
          },
          "width": {
            "signal": "totalWidth"
          },
          "y": {
            "signal": "datum.rowY"
          },
          "height": {
            "signal": "rowH"
          },
          "fillOpacity": {
            "value": 0
          },
          "tooltip": {
            "signal": "{'Nó': datum.Nome, 'Desvio': isValid(datum.Desvio) ? replace(format(datum.Desvio, '.2f'), '.', ',') + '%' : '--', 'Nota': isValid(datum.Nota) ? datum.Nota : '--', 'Planejado': 'R$ ' + replace(format(datum.Planejado, ',.0f'), /,/g, '.') + ' mil', 'Realizado': 'R$ ' + replace(format(datum.Realizado, ',.0f'), /,/g, '.') + ' mil'}"
          }
        },
        "hover": {
          "fillOpacity": {
            "value": 0.1
          }
        }
      }
    },
    {
      "type": "rule",
      "from": {
        "data": "navState"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "centerX"
          },
          "y": {
            "signal": "topPad"
          },
          "y2": {
            "signal": "topPad + min(contentH, viewportH)"
          },
          "stroke": {
            "value": "#9aa6b2"
          },
          "strokeWidth": {
            "value": 1.5
          },
          "opacity": {
            "signal": "tEase"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "navState"
      },
      "encode": {
        "enter": {
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "bottom"
          },
          "fontSize": {
            "value": 10
          },
          "fill": {
            "value": "#c0504d"
          }
        },
